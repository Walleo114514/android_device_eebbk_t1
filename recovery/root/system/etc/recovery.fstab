# TWRP recovery.fstab — 小天才 T1 (EEBBK / sm6150 / sdmmagpie), Android 11
# A-only, dynamic partitions (super), FBE v2 + metadata encryption
# <src>                                     <mnt_point>    <type>  <mnt_flags>                                      <fs_mgr_flags>

# Logical (dynamic) partitions — resolved at runtime through /dev/block/by-name/super
system                                      /system        ext4    ro,barrier=1,discard                             wait,logical,first_stage_mount
system_ext                                  /system_ext    ext4    ro,barrier=1,discard                             wait,logical,first_stage_mount
vendor                                      /vendor        ext4    ro,barrier=1,discard                             wait,logical,first_stage_mount
product                                     /product       ext4    ro,barrier=1,discard                             wait,logical,first_stage_mount

# Physical partitions
/dev/block/bootdevice/by-name/cache         /cache         ext4    noatime,nosuid,nodev,barrier=1                   wait,check
/dev/block/bootdevice/by-name/metadata      /metadata      ext4    noatime,nosuid,nodev,discard                     wait,check
/dev/block/bootdevice/by-name/persist       /persist       ext4    noatime,nosuid,nodev,barrier=1                   wait,check
/dev/block/bootdevice/by-name/dsp           /dsp           ext4    ro,nosuid,nodev,barrier=1                        wait
/dev/block/bootdevice/by-name/modem         /firmware      vfat    ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0  wait
/dev/block/bootdevice/by-name/bluetooth     /bt_firmware   vfat    ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337,context=u:object_r:bt_firmware_file:s0  wait
/dev/block/bootdevice/by-name/userdata      /data          f2fs    noatime,nosuid,nodev,discard                     wait,check,encryptable=footer

# Removable storage
/dev/block/mmcblk1p1                        /external_sd   vfat    nosuid,nodev                                     wait
/dev/block/bootdevice/by-name/usb            /usb-otg      vfat    nosuid,nodev                                     wait

# Raw block devices (flash / backup images)
/dev/block/bootdevice/by-name/boot          /boot          emmc    defaults                                         defaults
/dev/block/bootdevice/by-name/recovery      /recovery      emmc    defaults                                         defaults
/dev/block/bootdevice/by-name/dtbo          /dtbo          emmc    defaults                                         defaults
/dev/block/bootdevice/by-name/vbmeta        /vbmeta        emmc    defaults                                         defaults
/dev/block/bootdevice/by-name/vbmeta_system /vbmeta_system emmc    defaults                                         defaults
/dev/block/bootdevice/by-name/misc          /misc          emmc    defaults                                         defaults
/dev/block/bootdevice/by-name/modem         /modem         emmc    defaults                                         defaults
/dev/block/bootdevice/by-name/bluetooth     /bluetooth     emmc    defaults                                         defaults
/dev/block/bootdevice/by-name/persist       /persist_raw   emmc    defaults                                         defaults
/dev/block/bootdevice/by-name/fsg           /fsg           emmc    defaults                                         defaults
/dev/block/bootdevice/by-name/fsc           /fsc           emmc    defaults                                         defaults
/dev/block/bootdevice/by-name/ssd           /ssd           emmc    defaults                                         defaults
/dev/block/bootdevice/by-name/DDR           /DDR           emmc    defaults                                         defaults
/dev/block/bootdevice/by-name/super         /super         emmc    defaults                                         defaults
